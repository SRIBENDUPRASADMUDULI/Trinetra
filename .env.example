# =============================================================================
# CyberShield Bharat — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM / AI BACKEND (BharatCode / Groq / OpenAI / Local)
# -----------------------------------------------------------------------------
# Option A — BharatCode (recommended sovereign endpoint):
#   1. Sign in at https://bharatcode.ai and generate an API key ("bc_live_...")
#   2. Set LLM_BASE_URL=https://bharatcode.ai/api/model/v1
#   3. Set LLM_MODEL=qwen-3.8-27b (or deepseek-v4.1-flash)
#
# Option B — Groq:
#   https://api.groq.com/openai/v1  (model: llama3-70b-8192)
#
# Option C — OpenAI:
#   https://api.openai.com/v1  (model: gpt-4o)

LLM_API_KEY=
LLM_BASE_URL=https://bharatcode.ai/api/model/v1
LLM_MODEL=qwen-3.8-27b

BHARATCODE_API_KEY=
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b


# -----------------------------------------------------------------------------
# VIRUSTOTAL & GOOGLE SAFE BROWSING
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
