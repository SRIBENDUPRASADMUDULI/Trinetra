# =============================================================================
# CyberShield Bharat — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM / AI BACKEND
# -----------------------------------------------------------------------------
# Used by: AI Mentor, DevSec Auditor, Privacy Analyzer, FIR Generator modules.
#
# Option A — Groq (recommended, free tier available, very fast inference):
#   1. Sign up at https://console.groq.com
#   2. Navigate to API Keys -> Create API Key
#   3. Paste the key below (starts with "gsk_...")
#
# Option B — OpenAI:
#   1. Sign up at https://platform.openai.com
#   2. Navigate to API Keys -> Create new secret key
#   3. Set LLM_BASE_URL to https://api.openai.com/v1
#   4. Set LLM_MODEL to gpt-4o or gpt-3.5-turbo
#
# Option C — Self-hosted (Ollama, vLLM, LM Studio):
#   1. Set LLM_BASE_URL to your local endpoint e.g. http://localhost:11434/v1
#   2. Set LLM_MODEL to the model name you have pulled e.g. llama3:70b
#   3. LLM_API_KEY can be any non-empty string for local endpoints

LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama3-70b-8192


# -----------------------------------------------------------------------------
# VIRUSTOTAL
# -----------------------------------------------------------------------------
# Used by: URL/File reputation scanner module.
# Free tier: 4 requests/minute, 500 requests/day.
#
# How to get:
#   1. Create a free account at https://www.virustotal.com
#   2. Navigate to your Profile -> API Key
#   3. Copy the 64-character hex key and paste below

VIRUSTOTAL_API_KEY=


# -----------------------------------------------------------------------------
# GOOGLE SAFE BROWSING
# -----------------------------------------------------------------------------
# Used by: URL phishing/malware cross-check module.
# Free tier: 10,000 requests/day.
#
# How to get:
#   1. Go to https://console.cloud.google.com
#   2. Create a project (or select existing)
#   3. Enable "Safe Browsing API" in APIs & Services -> Library
#   4. Navigate to APIs & Services -> Credentials -> Create Credentials -> API Key
#   5. (Recommended) Restrict the key to Safe Browsing API only

GOOGLE_SAFE_BROWSING_KEY=


# -----------------------------------------------------------------------------
# HAVE I BEEN PWNED (HIBP)
# -----------------------------------------------------------------------------
# Used by: Credential leak checker (k-anonymity Pwned Passwords API).
# The Pwned Passwords v3 API is FREE and requires no key.
# The email search API (not used by default) requires a paid key from:
#   https://haveibeenpwned.com/API/Key
#
# This base URL is hardcoded in src/lib/env.ts -- no changes needed.
# PWNED_API_BASE=https://api.pwnedpasswords.com


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# NODE_ENV is automatically set by Next.js. Do NOT set it manually in .env.local.
# NODE_ENV=development

# Optional: Override the app's public URL (useful for OG tags, canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Analytics / telemetry (not implemented -- placeholder for future)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
